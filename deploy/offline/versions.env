# What an offline bundle of this K8s Sentinel release installs beside Sentinel
# itself. deploy/offline/build.sh renders these charts into the bundle and
# works the image list out from them, so the list is these versions' and no
# others'. Raise them here, build, and test before a release.
TETRAGON_CHART_VERSION=1.8.0
TRIVY_OPERATOR_CHART_VERSION=0.38.1
# The tags Trivy asks for when it downloads its databases.
TRIVY_DB_TAG=2
TRIVY_JAVA_DB_TAG=1
