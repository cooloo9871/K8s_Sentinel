{
  "event": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {
    "command": "# Check: PolicyForm line 42-44:
# processBinaries = value.process?.map((p) => p.binaries[0] ?? '') ?? []
# fileEntries = value.file?.map((f) => ({ path: f.paths[0] ?? '' })) ?? []
# These are derived directly from value prop on every render (not state)
# If value.networkPorts is undefined (PolicyFormInput has networkPorts?: string[])
# Line 257: (value.networkPorts ?? []).map(...) — safe with nullish coalescing

# The key question: does PolicyForm handle value.networkPorts === undefined?
# Yes, line 257, 263, 278, 292 all use (value.networkPorts ?? []) — safe.

# Check yamlToForm for the case where tcp_connect has a whitelist with ports:
# Selector 0: {matchArgs: [{operator:'NotDAddr', values:[...]}]}  → notDAddr found
# Selector 1: {matchArgs: [{operator:'NotDPort', values:[...]}]}  → falls to dPort check
# In selector 1: args = [{operator:'NotDPort',...}]
# notDAddr = args.find(a.operator==='NotDAddr') → undefined
# dAddr = args.find(a.operator==='DAddr') → undefined
# Neither branch fires. networkMode was already set to 'whitelist' from selector 0. OK.
# dPort = args.find(DPort || NotDPort) → finds {NotDPort} → pushes ports. OK.

# But here's an issue: what if the FIRST selector encountered has NotDPort but NOT NotDAddr?
# (e.g. hand-written YAML with just a port restriction and no address restriction)
# notDAddr=undefined, dAddr=undefined → no addresses pushed
# dPort found → ports pushed
# networkMode stays 'whitelist' (the default)
# Result: empty network[], populated networkPorts[], networkMode='whitelist'
# formToYaml would NOT generate a kprobe because netAddresses.length === 0
# → round-trip loses the port-only restriction silently. Minor edge case.

echo "done"",
    "description": "Check round-trip edge case for port-only restriction"
  }
}

