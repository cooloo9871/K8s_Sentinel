  const profiles = Object.values(profileMap).sort(
    (a, b) => `${a.namespace}/${a.pod}`.localeCompare(`${b.namespace}/${b.pod}`)
  )

  return (
    <DiscoveryContext.Provider value={{ profiles, clearProfiles }}>
      {children}
    </DiscoveryContext.Provider>
  )
