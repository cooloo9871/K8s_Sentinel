                    </TableCell>
                    <TableCell className="text-xs text-muted-foreground">
                      {e.nodeName || '—'}
                    </TableCell>
                    <TableCell>
                      <RelativeTime iso={e.time} />
                    </TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>
          )}
        </CardContent>
      </Card>
    </>
  )
}
