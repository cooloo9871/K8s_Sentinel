          "   mode: 'Mode Control',",
          "   namespaces: 'Namespaces',",
          "+  tetragon: 'Tetragon Agents',",
          " }",
          " ",
          " // Override the full breadcrumb trail for paths whose URL segments don't match"
        ]
      }
    ],
    "userModified": false,
    "replaceAll": false
  }
}

