            )}
          </CardContent>
        </Card>
      </div>

      {/* Mode switch confirmation */}
      <AlertDialog open={switchModal} onOpenChange={setSwitchModal}>
        <AlertDialogContent>
          <AlertDialogHeader>
            <AlertDialogTitle>切換模式</AlertDialogTitle>
            <AlertDialogDescription>
              確定要將模式切換為 <strong>{nextMode.toUpperCase()}</strong> 嗎？
