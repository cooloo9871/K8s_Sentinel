    // Try each pod until labels are found (some may have restarted)
    for (const pod of wl.pods) {
      try {
        const res = await podApi.labels(wl.namespace, pod)
        if (Object.keys(res.labels).length > 0) { podSelector = res.labels; break }
      } catch { /* continue */ }
    }
