export interface PodProfile {
  namespace: string
  pod: string
  binaries: string[]
  filePaths: string[]
  netDests: string[]
  firstSeen: string
  lastSeen: string
}

interface DiscoveryContextValue {
  profiles: PodProfile[]
  clearProfiles: () => void
}

const DiscoveryContext = createContext<DiscoveryContextValue>({
  profiles: [],
  clearProfiles: () => {},
})

export function useDiscovery() {
  return useContext(DiscoveryContext)
}

const POLL_INTERVAL_MS = 5000

export function DiscoveryProvider({ children }: { children: React.ReactNode }) {
  const [profiles, setProfiles] = useState<PodProfile[]>([])

  useEffect(() => {
    let cancelled = false
    const load = () => {
      fetch('/api/discovery/profiles')
        .then(r => r.json())
        .then(data => {
          if (!cancelled) setProfiles(data.profiles ?? [])
        })
        .catch(() => {})
    }
    load()
    const timer = setInterval(load, POLL_INTERVAL_MS)
    return () => {
      cancelled = true
      clearInterval(timer)
    }
  }, [])

  const clearProfiles = useCallback(() => {
    fetch('/api/discovery/profiles', { method: 'DELETE' })
      .then(() => setProfiles([]))
      .catch(() => {})
  }, [])

  return (
    <DiscoveryContext.Provider value={{ profiles, clearProfiles }}>
      {children}
    </DiscoveryContext.Provider>
  )
}
