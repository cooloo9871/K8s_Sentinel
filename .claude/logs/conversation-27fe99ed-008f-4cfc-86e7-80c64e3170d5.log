    "originalFile": "import { Input } from '@/components/ui/input'
import { Button } from '@/components/ui/button'
import type { NetworkRule } from '../../api/types'

interface Props {
  rules: NetworkRule[]
  onChange: (rules: NetworkRule[]) => void
}

export function NetworkSection({ rules, onChange }: Props) {
  const update = (i: number, patch: Partial<NetworkRule>) => {
    const next = [...rules]
    next[i] = { ...next[i], ...patch }
    onChange(next)
  }

  const add = () => onChange([...rules, { address: '', binaries: [] }])
  const remove = (i: number) => onChange(rules.filter((_, j) => j !== i))

  const parseBinaries = (raw: string): string[] =>
    raw.split(',').map(s => s.trim()).filter(Boolean)

  const binariesString = (r: NetworkRule) => (r.binaries ?? []).join(', ')

  return (
    <div className="flex flex-col gap-3">
      {rules.map((r, i) => (
        <div key={i} className="flex flex-col gap-1.5 rounded-md border p-3">
          <div className="flex items-center gap-2">
            <div className="flex flex-1 flex-col gap-1">
              <span className="text-xs text-muted-foreground">Address</span>
              <Input
                placeholder="e.g. 127.0.0.1 or 10.0.0.0/8"
                value={r.address}
                onChange={e => update(i, { address: e.target.value })}
                className="h-8 text-sm"
              />
            </div>
            <Button
              variant="ghost"
              size="sm"
              onClick={() => remove(i)}
              className="mt-5 shrink-0 text-muted-foreground hover:text-destructive"
            >
              ✕
            </Button>
          </div>
          <div className="flex flex-col gap-1">
            <span className="text-xs text-muted-foreground">
              Binaries <span className="text-muted-foreground/60">(optional — full path, comma-separated)</span>
            </span>
            <Input
              placeholder="/usr/bin/curl, /usr/bin/wget"
              value={binariesString(r)}
              onChange={e => update(i, { binaries: parseBinaries(e.target.value) })}
              className="h-8 text-sm"
            />
            {(r.binaries ?? []).some(b => b && !b.startsWith('/')) && (
              <p className="text-xs text-amber-600">⚠ Binary paths must start with / (e.g. /usr/bin/curl, not curl)</p>
            )}
          </div>
        </div>
      ))}
      <div>
        <Button variant="outline" size="sm" onClick={add}>+ Add</Button>
      </div>
    </div>
  )
}
",
    "userModified": false
  }
}

