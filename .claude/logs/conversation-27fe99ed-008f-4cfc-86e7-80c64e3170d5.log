    "content": "package k8s

import (
	"context"
	"fmt"
	"time"

	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
	"google.golang.org/grpc"
	"google.golang.org/grpc/credentials/insecure"
)

// StartDiscoveryLoop runs a background goroutine that:
//  1. Seeds Discovery with already-running processes via Tetragon gRPC DumpProcessCache.
//  2. Continuously streams new Tetragon process_exec events.
func (s *Store) StartDiscoveryLoop(ctx context.Context) {
	go func() {
		s.scanRunningProcesses(ctx)

		for {
			if ctx.Err() != nil {
				return
			}
			s.runDiscoveryOnce(ctx)
			if ctx.Err() != nil {
				return
			}
			fmt.Println("[sentinel-discovery] stream ended — reconnecting in 10s")
			select {
			case <-ctx.Done():
				return
			case <-time.After(10 * time.Second):
			}
		}
	}()
}

func (s *Store) runDiscoveryOnce(ctx context.Context) {
	events := make(chan TetragonEvent, 256)
	go func() {
		defer close(events)
		if err := s.StreamTetragonEvents(ctx, events); err != nil && ctx.Err() == nil {
			fmt.Printf("[sentinel-discovery] stream error: %v\
", err)
		}
	}()
	for evt := range events {
		s.Discovery.Update(evt)
	}
}

// scanRunningProcesses calls Tetragon's DumpProcessCache gRPC method on each
// node to get ALL processes Tetragon is currently tracking — including those
// that started before Sentinel was deployed.
func (s *Store) scanRunningProcesses(ctx context.Context) {
	if s.typed == nil {
		return
	}

	// Find all Tetragon pods and their IPs.
	pods, err := s.findTetragonPodsWithIPs(ctx)
	if err != nil || len(pods) == 0 {
		// Fall back to pod spec seeding.
		s.seedFromPodSpecs(ctx)
		return
	}

	total := 0
	for _, info := range pods {
		n, err := s.dumpProcessCacheFromNode(ctx, info[0], info[1])
		if err != nil {
			fmt.Printf("[sentinel-discovery] gRPC %s: %v\
", info[0], err)
		} else {
			total += n
		}
	}
	fmt.Printf("[sentinel-discovery] seeded %d processes via Tetragon gRPC\
", total)
}

// findTetragonPodsWithIPs returns [][2]string{{podName, podIP}, ...}.
func (s *Store) findTetragonPodsWithIPs(ctx context.Context) ([][2]string, error) {
	var result [][2]string
	for _, sel := range []string{"app.kubernetes.io/name=tetragon", "app=tetragon"} {
		list, err := s.typed.CoreV1().Pods("kube-system").List(ctx, metav1.ListOptions{
			LabelSelector: sel,
		})
		if err == nil && len(list.Items) > 0 {
			for _, p := range list.Items {
				if p.Status.PodIP != "" {
					result = append(result, [2]string{p.Name, p.Status.PodIP})
				}
			}
			return result, nil
		}
	}
	return nil, fmt.Errorf("no Tetragon pods found")
}

// dumpProcessCacheFromNode connects to a Tetragon pod gRPC server and calls
// DumpProcessCache to retrieve all tracked processes on that node.
func (s *Store) dumpProcessCacheFromNode(ctx context.Context, podName, podIP string) (int, error) {
	addr := fmt.Sprintf("%s:54321", podIP)
	conn, err := grpc.NewClient(addr, grpc.WithTransportCredentials(insecure.NewCredentials()))
	if err != nil {
		return 0, fmt.Errorf("dial %s: %w", addr, err)
	}
	defer conn.Close()

	rpcCtx, cancel := context.WithTimeout(ctx, 15*time.Second)
	defer cancel()

	// Raw gRPC invoke: DumpProcessCache takes an empty request and returns
	// ProcessCacheList. We decode the response manually using protobuf wire format.
	var respBytes []byte
	err = conn.Invoke(rpcCtx,
		"/tetragon.FineGuidanceSensors/DumpProcessCache",
		&dumpProcessCacheReq{},
		(*rawProtoBytes)(&respBytes),
	)
	if err != nil {
		return 0, fmt.Errorf("DumpProcessCache: %w", err)
	}

	now := time.Now().UTC().Format(time.RFC3339)
	entries := parseProcessCacheList(respBytes)
	count := 0
	for _, e := range entries {
		if e.namespace == "" || e.pod == "" || e.binary == "" {
			continue
		}
		s.Discovery.Update(TetragonEvent{
			Type:      "exec",
			Namespace: e.namespace,
			Pod:       e.pod,
			Binary:    e.binary,
			Time:      now,
		})
		count++
	}
	fmt.Printf("[sentinel-discovery] %s: %d processes from cache\
", podName, count)
	return count, nil
}

// seedFromPodSpecs is the fallback when gRPC is unavailable.
func (s *Store) seedFromPodSpecs(ctx context.Context) {
	if s.typed == nil {
		return
	}
	pods, err := s.typed.CoreV1().Pods("").List(ctx, metav1.ListOptions{
		FieldSelector: "status.phase=Running",
	})
	if err != nil {
		return
	}
	now := time.Now().UTC().Format(time.RFC3339)
	count := 0
	for _, pod := range pods.Items {
		for _, c := range pod.Spec.Containers {
			if len(c.Command) > 0 && c.Command[0] != "" {
				s.Discovery.Update(TetragonEvent{
					Type: "exec", Namespace: pod.Namespace, Pod: pod.Name,
					Binary: c.Command[0], Time: now,
				})
				count++
			}
		}
	}
	fmt.Printf("[sentinel-discovery] seeded %d processes from pod specs (fallback)\
", count)
}
"
  }
}

