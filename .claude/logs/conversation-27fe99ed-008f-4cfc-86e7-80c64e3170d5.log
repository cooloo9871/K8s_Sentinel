	return func(w http.ResponseWriter, r *http.Request) {
		namespace := chi.URLParam(r, "namespace")
		pod := chi.URLParam(r, "pod")
		labels, err := store.GetPodLabels(r.Context(), namespace, pod)
		if err != nil {
