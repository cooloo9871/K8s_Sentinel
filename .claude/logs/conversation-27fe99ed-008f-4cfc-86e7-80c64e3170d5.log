  "tool_input": {
    "file_path": "/home/bigred/Sentinel/internal/k8s/discovery_store.go",
    "content": "package k8s

import (
	"encoding/json"
	"os"
	"sort"
	"sync"
	"time"
)

// PodProfile accumulates observed behaviors for a single pod.
type PodProfile struct {
	Namespace string   `json:"namespace"`
	Pod       string   `json:"pod"`
	Binaries  []string `json:"binaries"`
	FilePaths []string `json:"filePaths"`
	NetDests  []string `json:"netDests"`
	FirstSeen string   `json:"firstSeen"`
	LastSeen  string   `json:"lastSeen"`
}

// DiscoveryProfileStore keeps profiles in memory and persists them to a JSON
// file on the pod filesystem. The in-memory map is always the source of truth;
// the file is written in the background with a 2-second debounce.
type DiscoveryProfileStore struct {
	mu       sync.RWMutex
	profiles map[string]*PodProfile
	filePath string
	saveCh   chan struct{}
}

func NewDiscoveryProfileStore(filePath string) *DiscoveryProfileStore {
	s := &DiscoveryProfileStore{
		profiles: make(map[string]*PodProfile),
		filePath: filePath,
		saveCh:   make(chan struct{}, 1),
	}
	s.load()
	go s.saveLoop()
	return s
}

func (s *DiscoveryProfileStore) Update(evt TetragonEvent) {
	if evt.Namespace == "" || evt.Pod == "" {
		return
	}
	key := evt.Namespace + "/" + evt.Pod
	s.mu.Lock()
	p, ok := s.profiles[key]
	if !ok {
		p = &PodProfile{
			Namespace: evt.Namespace,
			Pod:       evt.Pod,
			FirstSeen: evt.Time,
			LastSeen:  evt.Time,
		}
		s.profiles[key] = p
	}
	if evt.Time > p.LastSeen {
		p.LastSeen = evt.Time
	}
	changed := false
	if evt.Binary != "" && !sliceContains(p.Binaries, evt.Binary) {
		p.Binaries = append(p.Binaries, evt.Binary)
		changed = true
	}
	if evt.FilePath != "" && !sliceContains(p.FilePaths, evt.FilePath) {
		p.FilePaths = append(p.FilePaths, evt.FilePath)
		changed = true
	}
	if evt.NetDest != "" && !sliceContains(p.NetDests, evt.NetDest) {
		p.NetDests = append(p.NetDests, evt.NetDest)
		changed = true
	}
	if !ok || changed {
		s.mu.Unlock()
		s.triggerSave()
		return
	}
	s.mu.Unlock()
}

func (s *DiscoveryProfileStore) All() []*PodProfile {
	s.mu.RLock()
	defer s.mu.RUnlock()
	result := make([]*PodProfile, 0, len(s.profiles))
	for _, p := range s.profiles {
		cp := *p
		result = append(result, &cp)
	}
	sort.Slice(result, func(i, j int) bool {
		ki := result[i].Namespace + "/" + result[i].Pod
		kj := result[j].Namespace + "/" + result[j].Pod
		return ki < kj
	})
	return result
}

func (s *DiscoveryProfileStore) Clear() {
	s.mu.Lock()
	s.profiles = make(map[string]*PodProfile)
	s.mu.Unlock()
	os.Remove(s.filePath)
}

// --- internal ---

func (s *DiscoveryProfileStore) triggerSave() {
	select {
	case s.saveCh <- struct{}{}:
	default: // already pending, skip
	}
}

func (s *DiscoveryProfileStore) saveLoop() {
	timer := time.NewTimer(0)
	timer.Stop()
	for range s.saveCh {
		// Reset debounce: discard previous timer tick if still pending.
		if !timer.Stop() {
			select {
			case <-timer.C:
			default:
			}
		}
		timer.Reset(2 * time.Second)
		<-timer.C
		s.flush()
	}
}

func (s *DiscoveryProfileStore) flush() {
	s.mu.RLock()
	data, err := json.Marshal(s.profiles)
	s.mu.RUnlock()
	if err != nil {
		return
	}
	os.WriteFile(s.filePath, data, 0o644)
}

func (s *DiscoveryProfileStore) load() {
	data, err := os.ReadFile(s.filePath)
	if err != nil {
		return // file doesn't exist yet — start empty
	}
	var m map[string]*PodProfile
	if err := json.Unmarshal(data, &m); err != nil {
		return
	}
	s.profiles = m
}

func sliceContains(s []string, v string) bool {
	for _, x := range s {
		if x == v {
			return true
		}
	}
	return false
}
"
  }
}

