          " export type Severity = 'warning' | 'critical'",
          " ",
          " export interface DisplayEvent extends TetragonEvent {",
          "+  id: string   // stable unique ID set on creation, never changed on dedup",
          "   count: number",
          "   severity: Severity",
          " }"
        ]
      }
    ],
    "userModified": false,
    "replaceAll": false
  }
}

