		pod := chi.URLParam(r, "pod")
		labels, err := store.GetPodLabels(r.Context(), namespace, pod)
		if err != nil {
			writeJSON(w, http.StatusNotFound, map[string]string{"error": err.Error()})
			return
		}
		writeJSON(w, http.StatusOK, map[string]any{"labels": labels})
	}
}
