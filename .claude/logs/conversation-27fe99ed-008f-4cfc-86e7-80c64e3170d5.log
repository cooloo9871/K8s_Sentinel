    if (filter === 'warning' && e.severity !== 'warning') return false
    if (filter === 'critical' && e.severity !== 'critical') return false
    if (podSearch.trim() && !e.pod.toLowerCase().includes(podSearch.trim().toLowerCase())) return false
    return true
