              onClick={handleSwitch}
            >
              {nextMode === 'Protect' ? 'Turn On' : 'Turn Off'}
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>
    </>
  )
}
