      )}

      <AlertDialog open={clearDialog} onOpenChange={setClearDialog}>
        <AlertDialogContent>
          <AlertDialogHeader>
            <AlertDialogTitle>Clear Discovery Data</AlertDialogTitle>
            <AlertDialogDescription>
