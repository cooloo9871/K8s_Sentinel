                  <div className="mt-3 border-t pt-2 text-muted-foreground">
                    since <RelativeTime iso={wl.firstSeen} />
                  </div>
                </CardContent>
              </Card>
            )
          })}
        </div>
      )}

      <AlertDialog open={clearDialog} onOpenChange={setClearDialog}>
        <AlertDialogContent>
