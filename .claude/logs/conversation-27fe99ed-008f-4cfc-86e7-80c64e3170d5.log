				MatchActions: []ActionSelector{{Action: action}},
			}},
		})
	}

	// File rules: ONE security_file_permission kprobe with all paths combined.
	var allPaths []string
	for _, r := range input.File {
		allPaths = append(allPaths, r.Paths...)
	}
	if len(allPaths) > 0 {",
