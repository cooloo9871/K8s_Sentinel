}

func getPolicy(store *k8s.Store) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		name := chi.URLParam(r, "name")
		namespace := r.URL.Query().Get("namespace")

		record, err := store.Get(r.Context(), name, namespace)
		if err != nil {
