        // cluster-wide policies (namespace === undefined) causing mode to stay stale.
        setPolicyMode(
          yamlContent.toLowerCase().includes('sigkill') ? 'Protect' : 'Monitoring'
        )
      }
    }
    setActiveTab(tab)
  }

