}

type ArgSelector struct {
	Index    int      `yaml:"index"    json:"index"`
	Operator string   `yaml:"operator" json:"operator"`
	Values   []string `yaml:"values"   json:"values"`
}

type ActionSelector struct {
	Action string `yaml:"action" json:"action"`
