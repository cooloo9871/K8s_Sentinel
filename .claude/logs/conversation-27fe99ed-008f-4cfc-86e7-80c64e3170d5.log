          <span className="text-destructive">
            {events.filter(e => e.action === 'kill').length} kills
          </span>
          {paused && (
            <span className="ml-auto rounded bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">
              PAUSED
            </span>
          )}
        </div>

        <CardContent className="p-0">
