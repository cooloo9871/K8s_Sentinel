	if strings.Contains(strings.ToUpper(action), "SIGKILL") {
		evt.Action = "kill"
	} else {
		evt.Action = "monitor"
	}

	return evt, true
}

func fillProcess(evt *TetragonEvent, proc map[string]any) {
