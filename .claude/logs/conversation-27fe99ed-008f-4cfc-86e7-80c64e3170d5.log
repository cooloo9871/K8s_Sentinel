    onChange({ ...value, process: binaries.map((b) => ({ binaries: [b] })) })

  const setFileEntries = (entries: FileEntry[]) =>
    onChange({ ...value, file: entries.map((e) => ({ paths: [e.path] })) })

  const setNetRules = (rules: NetworkRule[]) =>
    onChange({ ...value, network: rules })


