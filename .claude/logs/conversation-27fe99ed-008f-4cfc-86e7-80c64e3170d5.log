import (
	"sort"
	"sync"
)

// PodProfile accumulates observed behaviors for a single pod.
type PodProfile struct {
	Namespace string   `json:"namespace"`
	Pod       string   `json:"pod"`
	Binaries  []string `json:"binaries"`
	FilePaths []string `json:"filePaths"`
	NetDests  []string `json:"netDests"`
	FirstSeen string   `json:"firstSeen"`
	LastSeen  string   `json:"lastSeen"`
}

// DiscoveryProfileStore holds in-memory pod behavior profiles.
// It is populated by the Tetragon event stream and queried by the API.
type DiscoveryProfileStore struct {
	mu       sync.RWMutex
	profiles map[string]*PodProfile // key = "namespace/pod"
}

func NewDiscoveryProfileStore() *DiscoveryProfileStore {
	return &DiscoveryProfileStore{profiles: make(map[string]*PodProfile)}
}

func (s *DiscoveryProfileStore) Update(evt TetragonEvent) {
	if evt.Namespace == "" || evt.Pod == "" {
		return
	}
	key := evt.Namespace + "/" + evt.Pod
	s.mu.Lock()
	defer s.mu.Unlock()
	p, ok := s.profiles[key]
	if !ok {
		p = &PodProfile{
			Namespace: evt.Namespace,
			Pod:       evt.Pod,
			FirstSeen: evt.Time,
			LastSeen:  evt.Time,
		}
		s.profiles[key] = p
	}
	if evt.Time > p.LastSeen {
		p.LastSeen = evt.Time
	}
	if evt.Binary != "" && !sliceContains(p.Binaries, evt.Binary) {
		p.Binaries = append(p.Binaries, evt.Binary)
	}
	if evt.FilePath != "" && !sliceContains(p.FilePaths, evt.FilePath) {
		p.FilePaths = append(p.FilePaths, evt.FilePath)
	}
	if evt.NetDest != "" && !sliceContains(p.NetDests, evt.NetDest) {
		p.NetDests = append(p.NetDests, evt.NetDest)
	}
}

func (s *DiscoveryProfileStore) All() []*PodProfile {
	s.mu.RLock()
	defer s.mu.RUnlock()
	result := make([]*PodProfile, 0, len(s.profiles))
	for _, p := range s.profiles {
		cp := *p
		result = append(result, &cp)
	}
	sort.Slice(result, func(i, j int) bool {
		ki := result[i].Namespace + "/" + result[i].Pod
		kj := result[j].Namespace + "/" + result[j].Pod
		return ki < kj
	})
	return result
}

func (s *DiscoveryProfileStore) Clear() {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.profiles = make(map[string]*PodProfile)
}

func sliceContains(s []string, v string) bool {
	for _, x := range s {
		if x == v {
			return true
		}
	}
	return false
}
