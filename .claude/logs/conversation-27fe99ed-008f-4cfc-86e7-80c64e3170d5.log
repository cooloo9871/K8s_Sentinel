    "content": "package k8s

import (
	"context"
	"fmt"
	"sync"
	"time"
)

// EventBus streams Tetragon events from a single background loop and fans out
// to any number of SSE subscribers. Discovery is updated regardless of
// whether any browser is connected.
type EventBus struct {
	store *Store

	mu   sync.RWMutex
	subs map[chan TetragonEvent]struct{}
}

func newEventBus(store *Store) *EventBus {
	return &EventBus{
		store: store,
		subs:  make(map[chan TetragonEvent]struct{}),
	}
}

// Subscribe returns a buffered channel that receives all future events.
// Call Unsubscribe when done.
func (b *EventBus) Subscribe() chan TetragonEvent {
	ch := make(chan TetragonEvent, 256)
	b.mu.Lock()
	b.subs[ch] = struct{}{}
	b.mu.Unlock()
	return ch
}

// Unsubscribe removes the channel from the fan-out set.
func (b *EventBus) Unsubscribe(ch chan TetragonEvent) {
	b.mu.Lock()
	delete(b.subs, ch)
	b.mu.Unlock()
}

func (b *EventBus) publish(evt TetragonEvent) {
	b.mu.RLock()
	defer b.mu.RUnlock()
	for ch := range b.subs {
		select {
		case ch <- evt:
		default: // subscriber too slow — drop rather than block
		}
	}
}

// Start runs the background loop: streams Tetragon events forever, updating
// Discovery and broadcasting to SSE subscribers. Restarts automatically on error.
func (b *EventBus) Start(ctx context.Context) {
	go func() {
		for {
			if ctx.Err() != nil {
				return
			}
			b.runOnce(ctx)
			if ctx.Err() != nil {
				return
			}
			fmt.Println("[sentinel] Tetragon stream ended — reconnecting in 10s")
			select {
			case <-ctx.Done():
				return
			case <-time.After(10 * time.Second):
			}
		}
	}()
}

func (b *EventBus) runOnce(ctx context.Context) {
	events := make(chan TetragonEvent, 256)
	go func() {
		defer close(events)
		if err := b.store.StreamTetragonEvents(ctx, events); err != nil && ctx.Err() == nil {
			fmt.Printf("[sentinel] Tetragon stream error: %v\
", err)
		}
	}()
	for evt := range events {
		b.store.Discovery.Update(evt)
		b.publish(evt)
	}
}
"
  }
}

