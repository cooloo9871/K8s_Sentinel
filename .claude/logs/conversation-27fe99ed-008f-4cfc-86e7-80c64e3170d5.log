              minHeight: 200,
              maxHeight: 500,
            }}
          >
            {yamlPreview || (
              <span style={{ color: '#555' }}>Enter a policy name to preview…</span>
            )}
          </pre>
        </div>
      </div>
    </div>
  )
}
",
