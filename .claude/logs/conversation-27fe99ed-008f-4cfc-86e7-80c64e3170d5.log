  )
}

function EventTypeBadge({ type, action }: { type: string; action: string }) {
  if (type === 'exec') return <Badge variant="secondary">exec</Badge>
  if (type === 'exit') return <Badge variant="outline">exit</Badge>
  if (type === 'kprobe' && action === 'kill')
