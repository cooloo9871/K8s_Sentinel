}

function WorkloadCard({ wl, creatingFor, onCreatePolicy, isAdmin }: {
  wl: WorkloadProfile
  creatingFor: string | null
  onCreatePolicy: (wl: WorkloadProfile) => void
  isAdmin: boolean
}) {
