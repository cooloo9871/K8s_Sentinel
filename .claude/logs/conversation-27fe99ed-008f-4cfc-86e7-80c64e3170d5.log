	if err != nil {
		return fmt.Errorf("create exec for pod %s: %w", podName, err)
	}

	pr, pw := io.Pipe()
	defer pr.Close()

	execDone := make(chan error, 1)
	go func() {
		defer pw.Close()
		execDone <- executor.StreamWithContext(ctx, remotecommand.StreamOptions{
			Stdout: pw,
		})
	}()

	scanner := bufio.NewScanner(pr)
