                  namespaces.map((ns) => (
                    <CTableRow key={ns}>
                      <CTableDataCell style={{ fontWeight: 500 }}>{ns}</CTableDataCell>
                      <CTableDataCell className="text-center">{policyCountByNs(ns)}</CTableDataCell>
                    </CTableRow>
                  ))
                )}
              </CTableBody>
            </CTable>
          )}
        </CCardBody>
      </CCard>
    </>
  )
}
