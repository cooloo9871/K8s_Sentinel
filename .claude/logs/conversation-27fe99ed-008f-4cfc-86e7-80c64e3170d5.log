				{Index: 1, Type: "int"},
			},
			Selectors: []KProbeSelector{{
				MatchArgs:    []ArgSelector{{Index: 0, Operator: "Prefix", Values: allPaths}},
				MatchActions: []ActionSelector{{Action: action}},
			}},
		})
	}

