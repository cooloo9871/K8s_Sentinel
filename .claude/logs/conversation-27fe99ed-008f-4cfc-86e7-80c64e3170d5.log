    "originalFile": "package k8s

import (
	"encoding/json"
	"os"
	"sort"
	"sync"
	"time"
)

// PodProfile accumulates process binaries observed for a single pod.
// Only process_exec events are used — no TracingPolicy required.
type PodProfile struct {
	Namespace string   `json:"namespace"`
	Pod       string   `json:"pod"`
	Binaries  []string `json:"binaries"`
	FirstSeen string   `json:"firstSeen"`
	LastSeen  string   `json:"lastSeen"`
}

type DiscoveryProfileStore struct {
	mu       sync.RWMutex
	profiles map[string]*PodProfile
	filePath string
	saveCh   chan struct{}
}

func NewDiscoveryProfileStore(filePath string) *DiscoveryProfileStore {
	s := &DiscoveryProfileStore{
		profiles: make(map[string]*PodProfile),
		filePath: filePath,
		saveCh:   make(chan struct{}, 1),
	}
	s.load()
	go s.saveLoop()
	return s
}

// Update records a process_exec event. Non-exec events are ignored.
func (s *DiscoveryProfileStore) Update(evt TetragonEvent) {
	if evt.Type != "exec" || evt.Namespace == "" || evt.Pod == "" || evt.Binary == "" {
		return
	}
	key := evt.Namespace + "/" + evt.Pod
	s.mu.Lock()
	p, ok := s.profiles[key]
	if !ok {
		p = &PodProfile{
			Namespace: evt.Namespace,
			Pod:       evt.Pod,
			Binaries:  []string{},
			FirstSeen: evt.Time,
			LastSeen:  evt.Time,
		}
		s.profiles[key] = p
	}
	if evt.Time > p.LastSeen {
		p.LastSeen = evt.Time
	}
	changed := !ok
	if !sliceContains(p.Binaries, evt.Binary) {
		p.Binaries = append(p.Binaries, evt.Binary)
		changed = true
	}
	s.mu.Unlock()
	if changed {
		s.triggerSave()
	}
}

func (s *DiscoveryProfileStore) All() []*PodProfile {
	s.mu.RLock()
	defer s.mu.RUnlock()
	result := make([]*PodProfile, 0, len(s.profiles))
	for _, p := range s.profiles {
		cp := *p
		if cp.Binaries == nil {
			cp.Binaries = []string{}
		}
		result = append(result, &cp)
	}
	sort.Slice(result, func(i, j int) bool {
		ki := result[i].Namespace + "/" + result[i].Pod
		kj := result[j].Namespace + "/" + result[j].Pod
		return ki < kj
	})
	return result
}

func (s *DiscoveryProfileStore) Clear() {
	s.mu.Lock()
	s.profiles = make(map[string]*PodProfile)
	s.mu.Unlock()
	os.Remove(s.filePath)
}

func (s *DiscoveryProfileStore) triggerSave() {
	select {
	case s.saveCh <- struct{}{}:
	default:
	}
}

func (s *DiscoveryProfileStore) saveLoop() {
	for range s.saveCh {
		time.Sleep(2 * time.Second)
		s.flush()
	}
}

func (s *DiscoveryProfileStore) flush() {
	s.mu.RLock()
	data, err := json.Marshal(s.profiles)
	s.mu.RUnlock()
	if err != nil {
		return
	}
	os.WriteFile(s.filePath, data, 0o644)
}

func (s *DiscoveryProfileStore) load() {
	data, err := os.ReadFile(s.filePath)
	if err != nil {
		return
	}
	var m map[string]*PodProfile
	if err := json.Unmarshal(data, &m); err != nil {
		return
	}
	s.profiles = m
}

func sliceContains(s []string, v string) bool {
	for _, x := range s {
		if x == v {
			return true
		}
	}
	return false
}
