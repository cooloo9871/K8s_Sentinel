		flusher.Flush()

		ch := store.EventBus.Subscribe()
		defer store.EventBus.Unsubscribe(ch)

		for {
			select {
			case evt, ok := <-ch:
				if !ok {
					return
				}
				data, err := json.Marshal(evt)
				if err != nil {
					continue
				}
				fmt.Fprintf(w, "data: %s\
\
", data)
				flusher.Flush()

			case <-r.Context().Done():
				return
			}
		}
	}
