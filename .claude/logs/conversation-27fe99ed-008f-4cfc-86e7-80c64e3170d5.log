	scanCtx, cancel := context.WithTimeout(ctx, 10*time.Second)
	defer cancel()

	var buf bytes.Buffer
	_ = executor.StreamWithContext(scanCtx, remotecommand.StreamOptions{Stdout: &buf})

	now := time.Now().UTC().Format(time.RFC3339)
