// New builds the HTTP handler tree.
func New(cfg Config) http.Handler {
	r := chi.NewRouter()
	r.Use(middleware.Logger)
	r.Use(middleware.Recoverer)

	r.Get("/api/policies", listPolicies(cfg.Store))
	r.Post("/api/policies", createPolicy(cfg.Store))
