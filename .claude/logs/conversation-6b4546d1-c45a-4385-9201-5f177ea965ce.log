type: Opaque
data:
  # Generate bcrypt hash: htpasswd -bnBC 10 "" "yourpassword" | tr -d ':\
' | base64
  # Generate JWT secret: openssl rand -base64 32 | base64
  admin: REPLACE_WITH_BASE64_BCRYPT_HASH
  jwt-secret: REPLACE_WITH_BASE64_JWT_SECRET
```

The overlay README comment explains how to generate values:
```bash
# Generate bcrypt hash of "admin123" and base64-encode it:
python3 -c "import bcrypt,base64; h=bcrypt.hashpw(b'admin123',bcrypt.gensalt()); print(base64.b64encode(h).decode())"

# Generate random JWT secret and base64-encode it:
openssl rand -base64 32 | base64
```

