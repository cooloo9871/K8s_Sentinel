package main

import (
	"fmt"
	"time"
	"golang.org/x/crypto/bcrypt"
)

func main() {
	dummy := "$2a$10$YzJDJjIwMjYwNTI4aGFzaGVzaGVzAAAAAAAAAAAAAAAAAAAAAAAAAA"
	real, _ := bcrypt.GenerateFromPassword([]byte("dummy"), 10)

	// Warmup
	bcrypt.CompareHashAndPassword([]byte(dummy), []byte("x"))
	bcrypt.CompareHashAndPassword(real, []byte("x"))

	t1 := time.Now()
	bcrypt.CompareHashAndPassword([]byte(dummy), []byte("anything"))
	d1 := time.Since(t1)

	t2 := time.Now()
	bcrypt.CompareHashAndPassword(real, []byte("anything"))
	d2 := time.Since(t2)

	fmt.Printf("dummy-hash duration: %v\
", d1)
	fmt.Printf("real-hash  duration: %v\
", d2)
}
EOF
go run /tmp/bcrypt_timing.go 2>&1",
    "description": "Compare bcrypt timing between dummy and real hash"
