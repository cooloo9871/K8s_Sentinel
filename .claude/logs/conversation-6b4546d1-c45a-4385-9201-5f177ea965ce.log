### Step 6: Create PolicyForm.tsx

**Important note on form field names:** The ProcessSection, FileSection, and NetworkSection components use `name={[name, 'process']}` etc., where `name` is a prop. In PolicyForm, pass the correct field path so the form values map to `PolicyFormInput` structure (name, namespace, process[], file[], network[]).

```tsx
import { useEffect } from 'react'
import { Form, Input, Select, Row, Col, Divider, Button, Space } from 'antd'
import { ProcessSection } from './ProcessSection'
import { FileSection } from './FileSection'
import { NetworkSection } from './NetworkSection'
import { YamlPreview } from './YamlPreview'
import { formToYaml } from '../../utils/formToYaml'
import type { PolicyFormInput } from '../../api/types'

interface Props {
  initialValues?: Partial<PolicyFormInput>
  namespaces: string[]
  action: string
  onSubmit: (values: PolicyFormInput) => Promise<void>
  loading?: boolean
}

export function PolicyForm({ initialValues, namespaces, action, onSubmit, loading }: Props) {
  const [form] = Form.useForm<PolicyFormInput>()
  const formValues = Form.useWatch([], form)

  const yamlPreview = (() => {
    try {
      if (!formValues?.name) return ''
      return formToYaml(formValues as PolicyFormInput, action)
    } catch {
      return ''
    }
  })()

  useEffect(() => {
    if (initialValues) form.setFieldsValue(initialValues)
  }, [initialValues, form])

  return (
    <Row gutter={24}>
      <Col span={14}>
        <Form form={form} layout="vertical" onFinish={onSubmit}>
          <Form.Item name="name" label="Policy Name" rules={[{ required: true }]}>
            <Input placeholder="my-policy" />
          </Form.Item>
          <Form.Item name="namespace" label="Namespace (leave empty for cluster-wide)">
            <Select allowClear placeholder="cluster-wide" options={namespaces.map((n) => ({ value: n, label: n }))} />
          </Form.Item>
          <Divider />
          <ProcessSection name="process" />
          <Divider />
          <FileSection name="file" />
          <Divider />
          <NetworkSection name="network" />
          <Divider />
          <Form.Item>
            <Space>
              <Button type="primary" htmlType="submit" loading={loading}>
                Apply Policy
              </Button>
            </Space>
          </Form.Item>
        </Form>
      </Col>
      <Col span={10}>
        <div style={{ position: 'sticky', top: 24 }}>
          <strong>YAML Preview</strong>
          <YamlPreview yamlText={yamlPreview} />
        </div>
      </Col>
    </Row>
  )
}
```

**Note about ProcessSection/FileSection/NetworkSection:** The `name` prop passed to them (e.g., `name="process"`) is used as `Form.List name={[name, 'process']}` in the sub-components. But we want the form structure to match `PolicyFormInput` which has top-level `process`, `file`, `network` arrays. So pass `name=""` (empty string) or restructure.

Actually, looking at the component code more carefully — `ProcessSection` uses `Form.List name={[name, 'process']}`. If `name=""` (empty), that creates `['', 'process']` which is wrong. The simpler approach: change the sections so `name` is the array field name directly, and use `Form.List name={name}`:

**Revised ProcessSection, FileSection, NetworkSection:** Change `Form.List name={[name, 'process']}` to just `Form.List name={name}`. Then in PolicyForm pass `name="process"`, `name="file"`, `name="network"`.

Update all three section components to use `<Form.List name={name}>` (not `name={[name, 'process']}`).

