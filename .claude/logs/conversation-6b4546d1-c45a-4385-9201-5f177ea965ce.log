	}
	obj := &unstructured.Unstructured{}
	if err := json.Unmarshal(jsonBytes, &obj.Object); err != nil {
		return fmt.Errorf("unmarshal YAML: %w", err)
	}

	name := obj.GetName()
	ns := obj.GetNamespace()

	if ns != "" {
		return s.applyNamespaced(ctx, ns, name, obj)
	}
	return s.applyCluster(ctx, name, obj)
}

