		mode, err := store.GetMode(r.Context())
		if err != nil {
			http.Error(w, `{"error":"failed to get mode"}`, http.StatusInternalServerError)
			return
		}
		writeJSON(w, http.StatusOK, map[string]string{"mode": mode})
	}
